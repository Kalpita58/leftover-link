NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/leftoverlink?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: enables the restaurant listing-draft assistant. Keep this key private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set these only when creating the first administrator account.
ADMIN_NAME=Leftover Link Admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-long-unique-password
